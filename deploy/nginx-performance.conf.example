# nginx performance snippet for sweetdrip.cafe
# Merge into your existing server { } block — does not change site design.

# API upstream
upstream sweetdrip_api {
    server 127.0.0.1:5025;
    keepalive 64;
}

upstream sweetdrip_web {
    server 127.0.0.1:3000;
    keepalive 32;
}

# Gzip — smaller JSON catalog + HTML
gzip on;
gzip_vary on;
gzip_proxied any;
gzip_comp_level 5;
gzip_min_length 256;
gzip_types
    application/json
    application/javascript
    text/css
    text/plain
    text/xml
    image/svg+xml;

# Public catalog — cache at edge/proxy (API also sets Cache-Control)
# location /api/catalog {
#     proxy_pass http://sweetdrip_api;
#     proxy_http_version 1.1;
#     proxy_set_header Connection "";
#     proxy_cache_valid 200 60s;
# }

server {
    listen 443 ssl http2;
    server_name sweetdrip.cafe www.sweetdrip.cafe;

    client_max_body_size 50m;

    # Static build assets — long cache
    location ~* ^/(assets|_build)/ {
        proxy_pass http://sweetdrip_web;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location /api/ {
        proxy_pass http://sweetdrip_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
        proxy_buffering on;
    }

    location / {
        proxy_pass http://sweetdrip_web;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
