# Copy to /etc/sweetdrip-api.env on the VPS (chmod 600) and load from systemd.
# Replace YOUR_EMAIL_PASSWORD with the mailbox password for admin@sweetdripcafe.com

Email__Enabled=true
Email__SmtpHost=mail.privateemail.com
Email__SmtpPort=587
Email__UseSsl=true
Email__Username=admin@sweetdripcafe.com
Email__Password=YOUR_EMAIL_PASSWORD
Email__FromAddress=admin@sweetdripcafe.com
Email__NotifyAddress=admin@sweetdripcafe.com
Email__FromName=Sweet Drip Cafe
Email__AdminUrl=https://sweetdrip.cafe/admin
