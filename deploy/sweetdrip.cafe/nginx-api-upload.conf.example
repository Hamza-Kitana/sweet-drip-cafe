# REQUIRED on VPS — admin image uploads fail with "fetch failed" without this.
# nginx default body limit is 1 MB; larger photos are rejected before the API runs.
#
# Apply on api.sweetdrip.cafe (the subdomain the site calls for uploads):
#
#   sudo nano /etc/nginx/sites-available/api.sweetdrip.cafe
#
# Inside server { ... } add:
#
#   client_max_body_size 50m;
#   proxy_read_timeout 120s;
#   proxy_send_timeout 120s;
#
# Then:
#
#   sudo nginx -t && sudo systemctl reload nginx
#
# Verify (should return HTTP 401, not 413):
#
#   curl -sS -o /dev/null -w "%{http_code}\n" -X POST \
#     -F "file=@/path/to/any-2mb-file.bin;type=image/png" \
#     https://api.sweetdrip.cafe/api/admin/media/upload

client_max_body_size 50m;
proxy_read_timeout 120s;
proxy_send_timeout 120s;
