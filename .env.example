# Stripe — get keys from https://dashboard.stripe.com/apikeys
# Use test keys (pk_test_ / sk_test_) while developing.

# Public key — safe for the browser (VITE_ prefix required)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# Secret key — server only, never commit the real value
STRIPE_SECRET_KEY=sk_test_your_secret_key_here

# Optional: webhook signing secret (for production payment confirmation)
# STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# C# API URL — when set, the site loads catalog/orders/admin data from SQL Server
# Local dev: http://localhost:5025
VITE_API_URL=http://localhost:5025
